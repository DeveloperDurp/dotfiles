{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/refs/heads/dev/assets/oh-my-opencode.schema.json",
  "telemetry": false,
  "team_mode": {
    "enabled": true
  },
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.6-terra",
      "maxTokens": 4000,
      "textVerbosity": "low",
      "compaction": {
        "model": "openai/gpt-5.6-luna"
      },
      "permission": {
        "doom_loop": "deny"
      }
    },
    "oracle": {
      "model": "openai/gpt-5.6-sol",
      "maxTokens": 4000,
      "textVerbosity": "low",
      "fallback_models": [
        {
          "model": "openai/gpt-5.6-terra"
        }
      ]
    },
    "librarian": {
      "model": "openai/gpt-5.6-luna",
      "maxTokens": 4000,
      "textVerbosity": "low",
      "fallback_models": [
        {
          "model": "openai/gpt-5.6-terra"
        }
      ]
    },
    "explore": {
      "model": "openai/gpt-5.3-codex-spark",
      "maxTokens": 4000,
      "textVerbosity": "low",
      "fallback_models": [
        {
          "model": "openai/gpt-5.6-luna"
        }
      ]
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.6-terra",
      "maxTokens": 2000,
      "textVerbosity": "low"
    },
    "prometheus": {
      "model": "openai/gpt-5.6-terra",
      "maxTokens": 4000,
      "textVerbosity": "low"
    },
    "metis": {
      "model": "openai/gpt-5.4-mini",
      "maxTokens": 4000,
      "textVerbosity": "low"
    },
    "momus": {
      "model": "openai/gpt-5.6-terra",
      "maxTokens": 4000,
      "textVerbosity": "low"
    },
    "atlas": {
      "model": "openai/gpt-5.6-luna",
      "maxTokens": 4000,
      "textVerbosity": "low",
      "fallback_models": [
        {
          "model": "openai/gpt-5.6-terra"
        }
      ]
    },
    "hephaestus": {
      "model": "openai/gpt-5.6-terra",
      "maxTokens": 4000,
      "textVerbosity": "low",
      "compaction": {
        "model": "openai/gpt-5.6-luna"
      },
      "permission": {
        "doom_loop": "deny"
      }
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5.3-codex-spark",
      "maxTokens": 4000,
      "textVerbosity": "low",
      "fallback_models": [
        {
          "model": "openai/gpt-5.6-luna"
        }
      ],
      "compaction": {
        "model": "openai/gpt-5.6-luna"
      },
      "permission": {
        "doom_loop": "deny"
      }
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "openai/gpt-5.6-terra"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.6-terra"
    },
    "deep": {
      "model": "openai/gpt-5.6-terra"
    },
    "artistry": {
      "model": "openai/gpt-5.6-terra"
    },
    "quick": {
      "model": "openai/gpt-5.3-codex-spark",
      "fallback_models": [
        {
          "model": "openai/gpt-5.6-luna"
        }
      ]
    },
    "unspecified-low": {
      "model": "openai/gpt-4o-mini"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.6-terra"
    },
    "writing": {
      "model": "openai/gpt-4.1-mini"
    }
  }
}
