{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/glm-5.3-flash",
  "small_model": "opencode-go/mimo-v2.5",
  "instructions": ["~/.agents/PONYTAIL.md"],
  "agent": {
    "build": {
      "description": "Builder (primary). Implements directly, checks CI, calls reviewers, and leaves the merge decision to the user.",
      "mode": "primary",
      "model": "openai/gpt-6.1-sol",
      "prompt": "{file:~/.agents/roles/build.md}",
      "permission": {
        "doom_loop": "deny",
        "edit": "allow",
        "bash": {
          "*": "allow",
          "git push --force*": "deny",
          "git push -f*": "deny",
          "gh pr merge*": "deny",
          "gh release*": "deny"
        },
        "external_directory": {
          "**": "ask",
          "~/.dotfiles/**": "allow",
          "~/.config/**": "allow",
          "~/.local/share/applications/**": "allow"
        }
      }
    },
    "plan": {
      "description": "Read-only planning consultant. Produces one decision-complete plan; implementation happens in build.",
      "mode": "primary",
      "model": "openai/gpt-6.1-sol",
      "prompt": "{file:~/.agents/roles/plan.md}",
      "permission": {
        "doom_loop": "deny",
        "edit": "deny",
        "bash": {
          "*": "ask", "ls*": "allow", "cat*": "allow", "rg*": "allow",
          "git status*": "allow", "git log*": "allow", "git diff*": "allow", "git show*": "allow"
        }
      }
    },
    "correctness": {
      "description": "Correctness reviewer. Logic, flow, edge cases, swallowed errors, test adequacy. Report only.",
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol",
      "prompt": "{file:~/.agents/roles/correctness.md}",
      "permission": {
        "doom_loop": "deny", "edit": "deny",
        "bash": {
          "*": "ask", "ls*": "allow", "cat*": "allow", "rg*": "allow",
          "git status*": "allow", "git log*": "allow", "git diff*": "allow", "git show*": "allow"
        }
      }
    },
    "security": {
      "description": "Security reviewer. Untrusted boundaries, injection, secrets, auth/file/network paths, infra diffs. Report only.",
      "mode": "subagent",
      "model": "openai/gpt-6-astra",
      "prompt": "{file:~/.agents/roles/security.md}",
      "permission": {
        "doom_loop": "deny", "edit": "deny",
        "bash": {
          "*": "ask", "ls*": "allow", "cat*": "allow", "rg*": "allow",
          "git status*": "allow", "git log*": "allow", "git diff*": "allow", "git show*": "allow"
        }
      }
    },
    "qa": {
      "description": "QA executor. Independently runs tests/build/typecheck and returns raw evidence. Never edits source.",
      "mode": "subagent",
      "model": "openai/gpt-6-astra",
      "prompt": "{file:~/.agents/roles/qa.md}",
      "permission": {
        "doom_loop": "deny", "edit": "deny",
        "bash": {
          "*": "ask", "npm test*": "allow", "npm run*": "allow",
          "pnpm test*": "allow", "pnpm run*": "allow", "yarn test*": "allow",
          "pytest*": "allow", "python -m pytest*": "allow",
          "go test*": "allow", "go build*": "allow", "go vet*": "allow",
          "cargo test*": "allow", "cargo build*": "allow", "cargo check*": "allow",
          "npx tsc*": "allow", "tsc*": "allow", "ruff*": "allow", "eslint*": "allow",
          "make test*": "allow", "make check*": "allow", "make build*": "allow"
        }
      }
    },
    "explore": {
      "description": "Cheap read-only explorer. Finds files, traces code/config flows, looks up docs, summarizes evidence. No implementation or test execution.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "prompt": "{file:~/.agents/roles/explore.md}",
      "permission": {
        "*": "deny",
        "read": { "*": "allow", "*.env": "ask", "*.env.*": "ask", "*.env.example": "allow" },
        "glob": "allow", "grep": "allow", "list": "allow", "lsp": "allow",
        "webfetch": "allow", "websearch": "allow", "external_directory": "ask"
      }
    },
    "metis": {
      "description": "Heavy requirements/scope reviewer. Finds hidden assumptions, missing context, acceptance gaps. Read-only.",
      "mode": "subagent",
      "model": "openai/gpt-6-astra",
      "prompt": "{file:~/.agents/roles/metis.md}",
      "permission": {
        "doom_loop": "deny", "edit": "deny", "task": "deny", "external_directory": "deny",
        "bash": {
          "*": "deny", "git status --short": "allow", "git log --oneline -10": "allow",
          "git diff": "allow", "git diff --cached": "allow", "git show": "allow"
        }
      }
    },
    "oracle": {
      "description": "Heavy architecture/debugging reviewer. Hard root causes, cross-boundary contracts, design trade-offs. Read-only.",
      "mode": "subagent",
      "model": "openai/gpt-6-astra",
      "prompt": "{file:~/.agents/roles/oracle.md}",
      "permission": {
        "doom_loop": "deny", "edit": "deny", "task": "deny", "external_directory": "deny",
        "bash": {
          "*": "deny", "git status --short": "allow", "git log --oneline -10": "allow",
          "git diff": "allow", "git diff --cached": "allow", "git show": "allow"
        }
      }
    },
    "prometheus": {
      "description": "Heavy plan reviewer. Audits feasibility, dependencies, acceptance criteria, verification before implementation. Read-only.",
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol",
      "prompt": "{file:~/.agents/roles/prometheus.md}",
      "permission": {
        "doom_loop": "deny", "edit": "deny", "task": "deny", "external_directory": "deny",
        "bash": {
          "*": "deny", "git status --short": "allow", "git log --oneline -10": "allow",
          "git diff": "allow", "git diff --cached": "allow", "git show": "allow"
        }
      }
    }
  }
}
