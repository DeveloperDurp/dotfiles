Host *
 IdentityAgent none
 IdentitiesOnly yes
 IdentityFile ~/.ssh/id_ed25519

#Host *
# ForwardAgent yes

host 192.168.30.200
  SetEnv TERM=xterm-256color

host 192.168.21.200
  SetEnv TERM=xterm-256color

host 192.168.20.200
  SetEnv TERM=xterm-256color

Host gitlab.durp.info
    User git
    Port 9022
    IdentityFile ~/.ssh/id_rsa

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_github
    IdentitiesOnly yes

Host opencode
  HostName hermes-agent.durp.loc 
  IdentityFile ~/.ssh/opencode_vm
  IdentitiesOnly yes

Host citadel.durp.loc
