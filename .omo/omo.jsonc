{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/refs/heads/dev/assets/omo.schema.json",
  "[opencode]": {
    "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/refs/heads/dev/assets/oh-my-opencode.schema.json",
    "telemetry": false,
    "team_mode": {
      "enabled": true,
      "max_parallel_members": 4,
      "max_members": 8,
      "tmux_visualization": false
    },
    "agents": {
      "sisyphus": {
        "model": "openai/gpt-5.6-luna",
        "variant": "xhigh",
        "compaction": {
          "model": "openai/gpt-5.6-luna"
        },
        "permission": {
          "doom_loop": "deny"
        }
      },
      "oracle": {
        "model": "openai/gpt-5.6-sol",
        "variant": "high"
      },
      "librarian": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low"
      },
      "explore": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low"
      },
      "multimodal-looker": {
        "model": "openai/gpt-5.6-luna",
        "variant": "medium"
      },
      "prometheus": {
        "model": "openai/gpt-5.6-sol",
        "variant": "high"
      },
      "metis": {
        "model": "openai/gpt-5.6-sol",
        "variant": "high"
      },
      "momus": {
        "model": "openai/gpt-5.6-sol",
        "variant": "high"
      },
      "atlas": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low"
      },
      "hephaestus": {
        "model": "openai/gpt-5.6-luna",
        "variant": "max",
        "compaction": {
          "model": "openai/gpt-5.6-luna"
        },
        "permission": {
          "doom_loop": "deny"
        }
      },
      "sisyphus-junior": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "compaction": {
          "model": "openai/gpt-5.6-luna"
        },
        "permission": {
          "doom_loop": "deny"
        }
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "openai/gpt-5.6-sol",
        "variant": "high"
      },
      "ultrabrain": {
        "model": "openai/gpt-5.6-sol",
        "variant": "high"
      },
      "deep": {
        "model": "openai/gpt-5.6-sol",
        "variant": "high"
      },
      "artistry": {
        "model": "openai/gpt-5.6-sol",
        "variant": "high"
      },
      "quick": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low"
      },
      "unspecified-low": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low"
      },
      "unspecified-high": {
        "model": "openai/gpt-5.6-luna",
        "variant": "max"
      },
      "writing": {
        "model": "openai/gpt-5.6-luna",
        "variant": "medium"
      }
    }
  },
  "_migrations": [
    "2026-08-reasoning-unification"
  ]
}
