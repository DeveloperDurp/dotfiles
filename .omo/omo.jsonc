{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/refs/heads/dev/assets/omo.schema.json",
  "[opencode]": {
    "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/refs/heads/dev/assets/oh-my-opencode.schema.json",
    "telemetry": false,
    "team_mode": {
      "enabled": true
    },
    "agents": {
      "sisyphus": {
        "model": "openai/gpt-5.6-sol",
        "compaction": {
          "model": "openai/gpt-5.6-terra"
        },
        "permission": {
          "doom_loop": "deny"
        },
        "maxTokens": 4000
      },
      "oracle": {
        "model": "openai/gpt-5.6-sol",
        "maxTokens": 4000,
        "fallback_models": [
          {
            "model": "openai/gpt-5.6-terra"
          }
        ]
      },
      "librarian": {
        "model": "openai/gpt-5.6-luna",
        "maxTokens": 4000,
        "fallback_models": [
          {
            "model": "openai/gpt-5.4-mini"
          }
        ]
      },
      "explore": {
        "model": "openai/gpt-5.6-luna",
        "maxTokens": 4000
      },
      "multimodal-looker": {
        "model": "openai/gpt-5.6-terra",
        "maxTokens": 2000
      },
      "prometheus": {
        "model": "openai/gpt-5.6-terra",
        "maxTokens": 4000
      },
      "metis": {
        "model": "openai/gpt-5.4-mini",
        "maxTokens": 4000
      },
      "momus": {
        "model": "openai/gpt-5.6-terra",
        "maxTokens": 4000
      },
      "atlas": {
        "model": "openai/gpt-5.6-luna",
        "maxTokens": 4000,
        "fallback_models": [
          {
            "model": "openai/gpt-5.4-mini"
          }
        ]
      },
      "hephaestus": {
        "model": "openai/gpt-5.6-terra",
        "compaction": {
          "model": "openai/gpt-5.6-luna"
        },
        "permission": {
          "doom_loop": "deny"
        },
        "maxTokens": 4000
      },
      "sisyphus-junior": {
        "model": "openai/gpt-5.6-luna",
        "compaction": {
          "model": "openai/gpt-5.6-luna"
        },
        "permission": {
          "doom_loop": "deny"
        },
        "maxTokens": 4000,
        "fallback_models": [
          {
            "model": "openai/gpt-5.4-mini"
          }
        ]
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "openai/gpt-5.6-sol"
      },
      "ultrabrain": {
        "model": "openai/gpt-5.6-sol"
      },
      "deep": {
        "model": "openai/gpt-5.6-sol"
      },
      "artistry": {
        "model": "openai/gpt-5.6-terra"
      },
      "quick": {
        "models": [
          "openai/gpt-4o-mini",
          {
            "model": "openai/gpt-5.6-luna"
          }
        ]
      },
      "unspecified-low": {
        "model": "openai/gpt-4o-mini"
      },
      "unspecified-high": {
        "model": "openai/gpt-5.6-terra"
      },
      "writing": {
        "model": "openai/gpt-4.1-mini"
      }
    }
  },
  "_migrations": [
    "2026-08-reasoning-unification"
  ]
}
