{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/refs/heads/dev/assets/omo.schema.json",
  "[opencode]": {
    "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/refs/heads/dev/assets/oh-my-opencode.schema.json",
    "telemetry": false,
    "team_mode": {
      "enabled": true,
      "max_parallel_members": 4,
      "max_members": 8,
      "tmux_visualization": false
    },
    "agents": {
      "sisyphus": {
        "model": "opencode-go/minimax-m3",
        "compaction": {
          "model": "opencode-go/mimo-v2.5"
        },
        "permission": {
          "doom_loop": "deny"
        },
        "maxTokens": 4000
      },
      "oracle": {
        "model": "opencode-go/glm-5.2",
        "compaction": {
          "model": "opencode-go/mimo-v2.5"
        },
        "maxTokens": 4000
      },
      "librarian": {
        "model": "opencode-go/mimo-v2.5",
        "compaction": {
          "model": "opencode-go/mimo-v2.5"
        },
        "maxTokens": 4000
      },
      "explore": {
        "model": "opencode-go/mimo-v2.5",
        "compaction": {
          "model": "opencode-go/mimo-v2.5"
        },
        "maxTokens": 4000
      },
      "multimodal-looker": {
        "model": "opencode-go/kimi-k2.7-code",
        "compaction": {
          "model": "opencode-go/mimo-v2.5"
        },
        "maxTokens": 2000
      },
      "prometheus": {
        "model": "opencode-go/glm-5.2",
        "compaction": {
          "model": "opencode-go/mimo-v2.5"
        },
        "maxTokens": 4000
      },
      "metis": {
        "model": "opencode-go/glm-5.2",
        "compaction": {
          "model": "opencode-go/mimo-v2.5"
        },
        "maxTokens": 4000
      },
      "momus": {
        "model": "opencode-go/glm-5.2",
        "compaction": {
          "model": "opencode-go/mimo-v2.5"
        },
        "maxTokens": 4000
      },
      "atlas": {
        "model": "opencode-go/mimo-v2.5",
        "compaction": {
          "model": "opencode-go/mimo-v2.5"
        },
        "maxTokens": 4000
      },
      "hephaestus": {
        "model": "opencode-go/kimi-k2.7-code",
        "compaction": {
          "model": "opencode-go/mimo-v2.5"
        },
        "permission": {
          "doom_loop": "deny"
        },
        "maxTokens": 4000
      },
      "sisyphus-junior": {
        "model": "opencode-go/kimi-k2.7-code",
        "compaction": {
          "model": "opencode-go/mimo-v2.5"
        },
        "permission": {
          "doom_loop": "deny"
        },
        "maxTokens": 4000
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "opencode-go/glm-5.2"
      },
      "ultrabrain": {
        "model": "opencode-go/kimi-k2.7-code"
      },
      "deep": {
        "model": "opencode-go/kimi-k2.7-code"
      },
      "artistry": {
        "model": "opencode-go/kimi-k2.7-code"
      },
      "quick": {
        "model": "opencode-go/mimo-v2.5"
      },
      "unspecified-low": {
        "model": "opencode-go/mimo-v2.5"
      },
      "unspecified-high": {
        "model": "opencode-go/kimi-k2.7-code"
      },
      "writing": {
        "model": "opencode-go/qwen3.7-plus"
      }
    }
  },
  "_migrations": [
    "2026-08-reasoning-unification"
  ]
}
